# Server only. The existing greeting/health endpoints still require no variables.
# Export in your server environment; this app does not automatically read .env.
# Use a long random token; configure the same secret in Cartesia webhook authentication.
REPORT_TOOL_TOKEN=
# Read call identity and transcript from Cartesia; never send this key to callers.
CARTESIA_API_KEY=
# Only allow calls belonging to this existing Managed Agent.
CARTESIA_AGENT_ID=
