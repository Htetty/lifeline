# Stable / Spectrum credentials from app.photon.codes, not the Beta API key.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Your assigned "Texts on" number, in E.164 format (+countrycode and digits).
SPECTRUM_LINE_NUMBER=
# Comma-separated enrolled sender numbers, also in E.164 format.
SPECTRUM_ALLOWED_SENDERS=

# Optional for `npm run location`. Otherwise an installed cloudflared creates a
# temporary HTTPS address automatically, exposing only the location test server.
# LOCATION_PORT=8091
# LOCATION_PUBLIC_URL=https://your-existing-tunnel.example

# `npm run location` control API for the voice backend (loopback only). The token is
# PHOTON_BRIDGE_TOKEN in backend/.env, which this launcher also reads.
# PHOTON_CONTROL_PORT=8092
