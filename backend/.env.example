# An isolated Convex deployment; never run regression exercises on shared data.
CONVEX_URL=
BACKEND_SECRET=
CLAUDE_MODEL=claude-sonnet-5-5
EXTRACTION_EFFORT=low
ANTHROPIC_API_KEY=

# Browser bridge; separate from BACKEND_SECRET. Generate a random value locally.
VOICE_BRIDGE_TOKEN=
CARTESIA_API_KEY=
# Reuse the configured agent's voice without changing the phone agent.
CARTESIA_AGENT_ID=
# Optional overrides for the separate browser speech flow:
# CARTESIA_VOICE_ID=
# CARTESIA_TTS_MODEL=sonic-3.6
