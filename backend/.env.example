# An isolated Convex deployment; never run regression exercises on shared data.
CONVEX_URL=
BACKEND_SECRET=
CLAUDE_MODEL=claude-sonnet-5-5
# Extraction model for the demo simulation's scripted callers (scripts/demo_sim.py)
SIM_CLAUDE_MODEL=claude-haiku-5-5
EXTRACTION_EFFORT=low
ANTHROPIC_API_KEY=

# Optional bearer token for the voice routes (browser bridge, simulator). Leave empty for an
# open demo; if set, clients must send it. Separate from BACKEND_SECRET.
VOICE_BRIDGE_TOKEN=
# Optional: only if the Convex deployment sets DISPATCHER_TOKEN (dashboard passcode); used by scripts/check_call_rules.py.
DISPATCHER_TOKEN=
# Optional ModernBERT model directory; leave unset to run without advisory tags.
CLASSIFIER_MODEL_PATH=
CARTESIA_API_KEY=
# Reuse the configured agent's voice without changing the phone agent.
CARTESIA_AGENT_ID=
# Optional overrides for the separate browser speech flow:
# CARTESIA_VOICE_ID=
# CARTESIA_TTS_MODEL=sonic-3.6

# Twilio bidirectional Media Streams (server-side; existing routing is opt-in).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Exact public HTTPS origin, no path, from your tunnel/deployment:
TWILIO_PUBLIC_BASE_URL=
